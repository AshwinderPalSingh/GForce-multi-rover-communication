Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Cell Size: 1
      Color: 160; 160; 164
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/Map
      Name: Hospital Map
      Enabled: true
      Topic:
        Value: /rover1/map
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: false
      Use Timestamp: false

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        map:
          Value: true
        rover1/base_link:
          Value: true
        rover1/odom:
          Value: true
        rover2/base_link:
          Value: true
        rover2/odom:
          Value: true

    - Class: rviz_default_plugins/LaserScan
      Name: Rover1 LiDAR
      Enabled: true
      Topic:
        Value: /rover1/scan
        Depth: 5
        Reliability Policy: Best Effort
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Style: Points

    - Class: rviz_default_plugins/LaserScan
      Name: Rover2 LiDAR
      Enabled: true
      Topic:
        Value: /rover2/scan
        Depth: 5
        Reliability Policy: Best Effort
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 85; 0
      Style: Points

    - Class: rviz_default_plugins/RobotModel
      Name: Rover1 Model
      Enabled: true
      Description Topic:
        Value: /rover1/robot_description
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      TF Prefix: rover1

    - Class: rviz_default_plugins/RobotModel
      Name: Rover2 Model
      Enabled: true
      Description Topic:
        Value: /rover2/robot_description
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      TF Prefix: rover2

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    # Two "2D Pose Estimate" buttons, one per rover. AMCL runs inside each
    # rover's namespace and listens on /roverX/initialpose, so the default
    # un-namespaced /initialpose had ZERO subscribers: the tool silently did
    # nothing, leaving no way to correct a drifted rover from RViz.
    # Toolbar order: the FIRST 2D Pose Estimate is rover1, the SECOND rover2
    # (RViz labels both with the plugin name, so order is the only cue).
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /rover1/initialpose
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /rover2/initialpose
    # /goal_pose is correct as-is: goal_dispatcher subscribes to it and
    # re-broadcasts on /fleet/goal_broadcast, so an RViz goal still goes
    # through the auction instead of bypassing negotiation.
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose

  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      Near Clip Distance: 0.01
      Scale: 50
      X: 0
      Y: 0

Window Geometry:
  Width: 1200
  Height: 800
  Displays:
    collapsed: false
